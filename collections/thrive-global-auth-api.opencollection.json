{
  "opencollection": "1.0.0",
  "info": {
    "name": "Thrive Global Partner audio experiences auth API",
    "version": "1.7.0"
  },
  "items": [
    {
      "info": {
        "name": "auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authenticate and obtain a bearer token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://partners-api.thriveglobal.com/v1/auth",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Exchange your API key for a JWT bearer token. Optionally provide a userId."
        }
      ]
    }
  ],
  "bundled": true
}