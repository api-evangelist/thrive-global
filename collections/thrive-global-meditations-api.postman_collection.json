  "info": {
    "_postman_id": "ba4cab48-85ef-4e55-9161-566354092e17",
    "name": "Thrive Global Partner audio experiences meditations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
