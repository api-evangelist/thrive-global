          "name": "Get a chronic condition program with weekly content",
          "request": {
            "name": "Get a chronic condition program with weekly content",
            "description": {
              "content": "Returns the full program structure with weekly content items. Each item has a `contentType` discriminator (article, roleModel, recipe, reset, microstep, lesson). Currently supports the GLP-1 Companion program.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "programs",
                ":programId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "en-US",
                  "description": "Content locale"
                },
                {
                  "disabled": false,
                  "key": "week",
                  "value": "<integer>",
                  "description": "Return a single week (0-indexed, 0 = welcome). Omit for all 52 weeks."
                },
                {
                  "disabled": false,
                  "key": "contentTypes",
                  "value": "<string>",
                  "description": "Comma-separated content types to include. Omit for all."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "programId",
                  "description": "(Required) Program identifier"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
